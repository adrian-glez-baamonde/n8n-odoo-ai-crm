# Copia este archivo a .env y rellena los valores.  NUNCA subas .env a git.

# --- General ---
TZ=Europe/Madrid

# --- PostgreSQL (usuario que usa Odoo) ---
POSTGRES_USER=odoo
POSTGRES_PASSWORD=cambia-esto

# --- n8n ---
N8N_VERSION=latest
# URL con la que se accede a n8n desde fuera (navegador, web de la tienda)
WEBHOOK_URL=http://localhost:5678/
# Clave para cifrar las credenciales en n8n. Genérala una vez y no la cambies
# (si la pierdes, las credenciales guardadas dejan de poder descifrarse).
# Ej.: python -c "import secrets; print(secrets.token_hex(32))"
N8N_ENCRYPTION_KEY=cambia-esto

# --- Odoo API (scripts/seed_odoo.py) ---
ODOO_URL=http://localhost:8069
ODOO_DB=modanorte
# Login del usuario (normalmente el email con el que creaste la base de datos)
ODOO_USER=tu-email@ejemplo.com
# Preferencias -> Seguridad de la cuenta -> Nueva clave API
ODOO_API_KEY=cambia-esto

# --- Usuario de solo lectura para el asistente (scripts/create_readonly_user.sql) ---
ASISTENTE_RO_PASSWORD=cambia-esto
