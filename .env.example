# Copia este archivo a .env y rellena los valores.  NUNCA subas .env a git.

# --- General ---
TZ=Europe/Madrid

# --- PostgreSQL (usuario que usa Odoo) ---
POSTGRES_USER=odoo
POSTGRES_PASSWORD=cambia-esto

# --- n8n ---
N8N_VERSION=latest
# URL con la que se accede a n8n desde fuera (navegador, web de la tienda)
WEBHOOK_URL=http://localhost:5678/
# Clave para cifrar las credenciales en n8n. Genérala una vez y no la cambies
# (si la pierdes, las credenciales guardadas dejan de poder descifrarse).
# Ej.: python -c "import secrets; print(secrets.token_hex(32))"
N8N_ENCRYPTION_KEY=cambia-esto
